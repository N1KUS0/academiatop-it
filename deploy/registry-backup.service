[Unit]
Description=Академия ТОП — резервная копия базы в Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=registry
Group=registry
WorkingDirectory=/opt/registry
Environment=REGISTRY_DB=/opt/registry/instance/registry.db
ExecStart=/opt/registry/.venv/bin/flask --app app send-backup

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/registry/instance
